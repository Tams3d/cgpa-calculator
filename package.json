{
  "name": "cgpa-calculator",
  "version": "1.0.0",
  "private": true,
  "description": "Regulation-aware SGPA, CGPA and percentage calculator for engineering students. Subject-by-subject entry with Anna University curricula.",
  "keywords": [
    "anna-university",
    "calculator",
    "cgpa",
    "curriculum",
    "engineering",
    "react",
    "sgpa",
    "tailwindcss",
    "vite"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run lint && bun run typecheck && bun run format:check",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@react-scan/vite-plugin-react-scan": "^0.2.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.75.0",
    "oxlint-tailwindcss": "^1.9.0",
    "react-scan": "^0.5.7",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20.19.0"
  },
  "packageManager": "bun@1.3.14"
}
